{
  "name": "glassofy-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "Glassofy Architectural Hardware E-Commerce Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server",
    "test:server": "npm test --prefix server",
    "test:qa": "playwright test tests/qa.spec.js",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "format": "npm run format --workspace=server && npm run format --workspace=client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.0.14",
    "pdfkit": "^0.20.2",
    "razorpay": "^2.9.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.2",
    "lighthouse": "^13.5.0",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "braces": "^3.0.3",
    "micromatch": "^4.0.8"
  }
}
