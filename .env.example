# ====================================================
# Glassofy E-Commerce Platform - Root Environment
# ====================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/glassofy
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=examplepassword

# JWT Auth
JWT_SECRET=glassofy_jwt_super_secret_key_change_me_in_production
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=glassofy_refresh_secret_key_change_me_in_production
JWT_REFRESH_EXPIRE=7d

# Initial Admin Seeding
ADMIN_NAME=Glassofy Admin
ADMIN_EMAIL=admin@glassofy.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_MOBILE=9876543210

# WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=glassofy_wa_verify_token_secure_2026
WHATSAPP_APP_SECRET=glassofy_wa_app_secret_dev_32char_key
WHATSAPP_ACCESS_TOKEN=EAAG...your_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=100609346426457
WHATSAPP_BUSINESS_ACCOUNT_ID=101827364521098
WHATSAPP_MOCK=false
WHATSAPP_NOTIFY_EMAIL=admin@glassofy.com

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api
